<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{reportTitle}} - {{appName}}</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            color: #1f2937;
            margin: 0;
            padding: 40px;
            background: #ffffff;
            font-size: 14px;
            line-height: 1.5;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #e5e7eb;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .company-info h1 {
            margin: 0 0 5px 0;
            font-size: 24px;
            color: #111827;
        }
        .report-meta {
            text-align: right;
            font-size: 13px;
            color: #6b7280;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 25px 0;
        }
        th, td {
            padding: 12px 14px;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
        }
        th {
            background-color: #f9fafb;
            font-weight: 600;
            color: #374151;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
            font-size: 12px;
            color: #9ca3af;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="company-info">
            <h1>{{appName}}</h1>
            <p>{{#if reportSubtitle}}{{reportSubtitle}}{{else}}System Report{{/if}}</p>
        </div>
        <div class="report-meta">
            <p><strong>Generated At:</strong> {{generatedAt}}</p>
            <p><strong>Reference:</strong> {{reportId}}</p>
        </div>
    </div>

    <h2>{{reportTitle}}</h2>
    <p>{{summary}}</p>

    {{#if items}}
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Item / Description</th>
                <th>Category</th>
                <th style="text-align: right;">Amount</th>
            </tr>
        </thead>
        <tbody>
            {{#each items}}
            <tr>
                <td>{{@index}}</td>
                <td>{{this.name}}</td>
                <td>{{this.category}}</td>
                <td style="text-align: right;">{{this.amount}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    {{/if}}

    <div class="footer">
        Generated automatically by {{appName}} &bull; Confidential
    </div>
</body>
</html>
