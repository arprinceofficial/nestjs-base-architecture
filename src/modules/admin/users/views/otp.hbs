<div style="text-align: center; margin-bottom: 24px;">
    <div style="display: inline-block; width: 56px; height: 56px; line-height: 56px; border-radius: 50%; background-color: #eff6ff; border: 2px solid #bfdbfe; margin-bottom: 12px; text-align: center;">
        <span style="font-size: 26px; color: #2563eb; line-height: 56px;">&#128274;</span>
    </div>
    <h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #111827;">Verification Code</h1>
    <p style="margin: 0; font-size: 14px; color: #6b7280;">Use this One-Time Password (OTP) to reset your account password</p>
</div>

<p style="margin: 0 0 16px 0; font-size: 15px; color: #374151;">
    Hello{{#if userName}} <strong>{{userName}}</strong>{{/if}},
</p>

<p style="margin: 0 0 24px 0; font-size: 15px; color: #374151; line-height: 1.6;">
    We received a request to reset the password for your account (<strong>{{email}}</strong>). Enter the verification code below to proceed:
</p>

<!-- OTP Code Box -->
<div style="text-align: center; margin: 28px 0;">
    <div style="display: inline-block; background-color: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 10px; padding: 18px 36px; text-align: center;">
        <span style="font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace; font-size: 32px; font-weight: 700; letter-spacing: 8px; color: #1d4ed8; display: inline-block;">
            {{otp}}
        </span>
    </div>
</div>

<p style="margin: 0 0 12px 0; font-size: 14px; color: #4b5563; line-height: 1.5;">
    &#9201; This code will expire in <strong>{{#if expiryMinutes}}{{expiryMinutes}}{{else}}10{{/if}} minutes</strong>.
</p>

<div style="background-color: #fffbeb; border-left: 4px solid #f59e0b; padding: 12px 16px; border-radius: 4px; margin-top: 20px;">
    <p style="margin: 0; font-size: 13px; color: #92400e; line-height: 1.5;">
        <strong>Security Notice:</strong> If you did not request this password reset, please ignore this email or reach out to our security team immediately. Never share your OTP with anyone.
    </p>
</div>
