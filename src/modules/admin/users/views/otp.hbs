<div style="text-align: center; margin-bottom: 24px;">
    <div style="display: inline-block; width: 56px; height: 56px; line-height: 56px; border-radius: 50%; background-color: #eff6ff; border: 2px solid #bfdbfe; margin-bottom: 12px; text-align: center;">
        <span style="font-size: 26px; color: #2563eb; line-height: 56px;">&#128274;</span>
    </div>
    <h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #111827;">One Time Password (OTP)</h1>
    <p style="margin: 0; font-size: 14px; color: #6b7280;">Verification code requested for your account</p>
</div>

<p style="margin: 0 0 16px 0; font-size: 15px; color: #374151;">
    Hello{{#if userName}} <strong>{{userName}}</strong>{{/if}},
</p>

<p style="margin: 0 0 20px 0; font-size: 15px; color: #374151; line-height: 1.6;">
    We received a request for authentication on your account (<strong>{{email}}</strong>).
</p>

<!-- Semantic text optimized for Gmail OTP extraction -->
<p style="margin: 0 0 8px 0; font-size: 15px; font-weight: 600; color: #1f2937; text-align: center;">
    Your verification code is:
</p>

<!-- OTP Code Box -->
<div style="text-align: center; margin: 16px 0 24px 0;">
    <div style="display: inline-block; background-color: #f8fafc; border: 2px dashed #93c5fd; border-radius: 12px; padding: 18px 40px; text-align: center;">
        <span style="font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace; font-size: 34px; font-weight: 700; letter-spacing: 10px; color: #1d4ed8; display: inline-block;">
            {{otp}}
        </span>
    </div>
</div>

<p style="margin: 0 0 12px 0; font-size: 14px; color: #4b5563; line-height: 1.5; text-align: center;">
    &#9201; This one-time password will expire in <strong>{{#if expiryMinutes}}{{expiryMinutes}}{{else}}10{{/if}} minutes</strong>.
</p>

<div style="background-color: #fffbeb; border-left: 4px solid #f59e0b; padding: 12px 16px; border-radius: 4px; margin-top: 24px;">
    <p style="margin: 0; font-size: 13px; color: #92400e; line-height: 1.5;">
        <strong>Security Notice:</strong> Never share your verification code with anyone. Our team will never ask for your code. If you did not make this request, you can safely ignore this email.
    </p>
</div>
